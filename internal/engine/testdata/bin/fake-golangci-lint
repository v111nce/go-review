#!/bin/sh
set -eu
mode=check
run_mode=fmt
files=""
for arg in "$@"; do
  case "$arg" in
    run) run_mode=run ;;
    --diff) mode=diff ;;
    -*|fmt|gofmt|goimports|gci|errcheck) ;;
    *) files="$files $arg" ;;
  esac
done
if [ -z "${files# }" ]; then
  files=$(find . -name '*.go' -type f | sort)
fi
if [ "$run_mode" = "run" ]; then
  for file in $files; do
    [ -f "$file" ] || continue
    if grep -q 'fmt.Errorf("ignored")' "$file"; then
      printf '%s:4:12: Error return value is not checked (errcheck)\n' "$file"
      exit 1
    fi
  done
  exit 0
fi
changed=0
for file in $files; do
  [ -f "$file" ] || continue
  if grep -q 'main(){' "$file" || grep -q 'Bad(){' "$file"; then
    changed=1
    if [ "$mode" = "diff" ]; then
      printf 'diff -- %s\n' "$file"
    else
      tmp=$(mktemp)
      sed 's/main(){/main() {/g; s/Bad(){/Bad() {/g' "$file" > "$tmp"
      cat "$tmp" > "$file"
      rm -f "$tmp"
    fi
  fi
done
if [ "$mode" = "diff" ] && [ "$changed" -eq 1 ]; then
  exit 1
fi
exit 0
